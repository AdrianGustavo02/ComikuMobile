<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Comiku" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="editTextStyle">@style/Theme.Comiku.PremiumEditText</item>
    </style>

    <style name="Theme.Comiku" parent="Base.Theme.Comiku" />

    <style name="Theme.Comiku.NavigationDrawerItemText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.Comiku.PremiumEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_premium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorHint">#7A7A7A</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Comiku.ButtonPrimaryAction" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_primary_action_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Theme.Comiku.ButtonSecondaryAction" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Theme.Comiku.ButtonSecondaryActionSoft" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary_action_soft</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Theme.Comiku.GenericTextInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_text_generic</item>
        <item name="android:textColor">#F8F3FF</item>
        <item name="android:textColorHint">#B8AFC6</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Theme.Comiku.DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/button_danger_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Theme.Comiku.VolumeDetailSearchButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_volume_detail_search_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="Theme.Comiku.ImagePickerTriggerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_image_picker_trigger</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#F8F3FF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>