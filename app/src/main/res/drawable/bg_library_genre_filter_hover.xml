<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#190e2a" />
            <stroke
                android:width="3dp"
                android:color="#6bff8a1f" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="#190e2a" />
            <stroke
                android:width="1dp"
                android:color="#94ff8a1f" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
