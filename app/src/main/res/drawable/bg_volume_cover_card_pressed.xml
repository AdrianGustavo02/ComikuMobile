<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#1fff8a1f" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <solid android:color="#0dffffff" />
            <stroke
                android:width="1dp"
                android:color="#57ff8a1f" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
