<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" android:topRightRadius="16dp" android:bottomRightRadius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFB05C"
                android:endColor="#FF8A1F" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" android:topRightRadius="16dp" android:bottomRightRadius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFB05C"
                android:endColor="#FF8A1F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
