<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCreacionManualComic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tituloCreacionManualComic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/creacion_manual_comic_titulo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtituloCreacionManualComic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/creacion_manual_comic_subtitulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/creacion_manual_seccion_comic"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoNombreComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/creacion_manual_comic_nombre"
            android:inputType="text"
            android:maxLength="120" />

        <EditText
            android:id="@+id/campoAutoresComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/creacion_manual_comic_autores"
            android:inputType="text"
            android:maxLength="300" />

        <Button
            android:id="@+id/botonAgregarAutorComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/creacion_manual_comic_boton_autor" />

        <LinearLayout
            android:id="@+id/contenedorAutoresComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/campoEditorialComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/creacion_manual_comic_editorial"
            android:inputType="text"
            android:maxLength="120" />

        <Spinner
            android:id="@+id/spinnerPaisEditorialComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerEstadoComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/campoFormatoComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/creacion_manual_comic_formato"
            android:inputType="text"
            android:maxLength="80" />

        <TextView
            android:id="@+id/textoGenerosComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/creacion_manual_comic_generos"
            android:textSize="14sp" />

        <Button
            android:id="@+id/botonGenerosComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/creacion_manual_comic_boton_generos" />

        <EditText
            android:id="@+id/campoDescripcionComicManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/creacion_manual_comic_descripcion"
            android:inputType="textMultiLine"
            android:maxLength="1000"
            android:minLines="3" />

        <TextView
            android:id="@+id/textoErrorCreacionManualComic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@android:color/holo_red_dark" />

        <ProgressBar
            android:id="@+id/barraCargaCreacionManualComic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botonContinuarCreacionManualComic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/creacion_manual_comic_boton_continuar" />

    </LinearLayout>
</ScrollView>
