<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorPresentacionInicio"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_carousel_container"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/imagenPresentacionInicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/inicio_presentacion_imagen_contenido"
        android:scaleType="fitXY" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_presentation_overlay"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/textoTituloPresentacionInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB05C"
            android:textSize="18sp"
            android:textStyle="normal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoDescripcionPresentacionInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/carousel_subtitle"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoApoyoPresentacionInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#EDE0FF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botonCrearComicPresentacionInicio"
            style="@style/Theme.Comiku.ButtonPrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/inicio_presentacion_boton_crear_comic"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>