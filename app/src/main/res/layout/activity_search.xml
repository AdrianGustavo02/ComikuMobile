<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/campoBusquedaComics"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="@string/busqueda_hint"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_input_busqueda"
            android:maxLength="200"
            android:textSize="16sp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/botonEscanerBusqueda"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/busqueda_boton_escaner"
            android:src="@drawable/ic_camera_isbn"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/botonCerrarBusqueda"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/busqueda_boton_cerrar"
            android:src="@drawable/ic_cerrar_x"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/barraCargaBusqueda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textoErrorBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@android:color/holo_red_dark" />

    <TextView
        android:id="@+id/textoSinResultadosBusqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listaResultadosBusqueda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp" />

</LinearLayout>
