<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDrawerPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/barraSuperiorPrincipal"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:minHeight="64dp"
            android:background="#12091D"
            app:titleTextColor="@android:color/white" />

        <FrameLayout
            android:id="@+id/contenedorContenidoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#12091D"
        android:clipToOutline="true"
        android:orientation="vertical">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/vistaNavegacionPrincipal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            app:headerLayout="@layout/view_drawer_profile_header"
            app:itemBackground="@drawable/nav_item_background"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/nav_item_icon_tint"
            app:itemTextAppearance="@style/Theme.Comiku.NavigationDrawerItemText"
            app:itemTextColor="@color/nav_item_text_tint"
            app:menu="@menu/menu_drawer" />

        <LinearLayout
            android:id="@+id/contenedorCerrarSesionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12091D"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/menu_cerrar_sesion"
                android:src="@drawable/ic_cerrar_sesion"
                android:tint="@android:color/white"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/menu_cerrar_sesion"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
