<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Encabezado con titulo y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chats_titulo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonCrearGrupo"
            style="@style/Theme.Comiku.ButtonSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/chats_crear_grupo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/botonIniciarConversacion"
            style="@style/Theme.Comiku.ButtonSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chats_nueva_conversacion"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_light" />

    <!-- Lista de chats -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- RecyclerView de canales -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanales"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/estadoVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chats_vacio"
                android:textSize="16sp"
                android:textColor="@color/gray_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chats_vacio_desc"
                android:textSize="14sp"
                android:textColor="@color/gray"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Indicador de carga -->
        <ProgressBar
            android:id="@+id/indicadorCarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Mensaje de error -->
        <LinearLayout
            android:id="@+id/estadoError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chats_error"
                android:textSize="16sp"
                android:textColor="@color/red" />

            <TextView
                android:id="@+id/textoErrorDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:textSize="14sp"
                android:textColor="@color/gray"
                android:gravity="center" />

            <Button
                android:id="@+id/botonReintentar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reintentar"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
