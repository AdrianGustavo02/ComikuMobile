<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Barra de carga -->
    <ProgressBar
        android:id="@+id/barraCargaVolumeDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Mensaje de error -->
    <TextView
        android:id="@+id/textoErrorVolumeDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_light"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="top"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="160dp"
                    android:layout_height="224dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="10dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="false">

                    <com.example.comiku.screens.RoundedImageView
                        android:id="@+id/imagenPortadaVolumeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/portada_del_tomo"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/contenedorNombreComicVolumeDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Nombre del comic -->
                        <TextView
                            android:id="@+id/textoNombreComicVolumeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iconoFlechaComicVolumeDetail"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_creator_arrow_right" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoNumeroTomoVolumeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones de acciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonAgregarBibliotecaVolumeDetail"
                    style="@style/Theme.Comiku.ButtonSecondaryAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/agregar_biblioteca" />

                <Button
                    android:id="@+id/botonAgregarDeseadosVolumeDetail"
                    style="@style/Theme.Comiku.ButtonSecondaryAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/agregar_deseados" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorMetadataVolumeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_carousel_container"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textoIsbnVolumeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/carousel_subtitle"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textoFechaPublicacionVolumeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/carousel_subtitle"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textoEstadoLecturaVolumeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/carousel_subtitle"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorLecturaVolumeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:text="@string/lectura_fecha_label"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/campoFechaLecturaVolumeDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="@string/lectura_fecha_hint"
                        android:inputType="none" />

                    <Button
                        android:id="@+id/botonIngresarFechaLecturaVolumeDetail"
                        style="@style/Theme.Comiku.ButtonSecondaryAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ingresar_fecha_lectura" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:text="@string/lectura_historial_titulo"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/textoSinLecturasVolumeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/lectura_historial_vacio"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/contenedorHistorialLecturaVolumeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoAyudaLecturaVolumeDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/lectura_necesita_biblioteca"
                android:textAlignment="center"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#33000000" />

            <!-- Contenedor de comercios cercanos (despues de textoAyudaLectura, antes de botones) -->
            <LinearLayout
                android:id="@+id/contenedorComerciosCercanos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tituloComerciosCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¿Donde comprar este tomo?"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/avisoComerciosCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comiku no conoce la disponibilidad de este tomo. Consulta el stock directamente con el comercio."
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/botonBuscarComerciosCercanos"
                    style="@style/Theme.Comiku.VolumeDetailSearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Buscar cerca mio"
                    android:layout_marginBottom="12dp" />

                <!-- Control segmentado para radios (oculto hasta primera busqueda) -->
                <LinearLayout
                    android:id="@+id/controlRadioComerciosCercanos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/botonRadio20km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_volume_detail_toggle_left_active"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="20 km"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/botonRadio50km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_volume_detail_toggle_right_inactive"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="50 km"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Indicador de carga -->
                <ProgressBar
                    android:id="@+id/cargaComerciosCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- RecyclerView para comercios con scroll propio -->
                <FrameLayout
                    android:id="@+id/contenedorListaComerciosCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewComerciosCercanos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical" />
                </FrameLayout>

                <!-- Mensaje vacio (sin resultados) -->
                <TextView
                    android:id="@+id/textoComerciosCercanosVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin resultados en 20 km. Ampliar a 50 km?"
                    android:textAlignment="center"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Mensaje de error -->
                <TextView
                    android:id="@+id/textoErrorComerciosCercanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/holo_red_dark"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/botonReportarVolumeDetail"
        style="@style/Theme.Comiku.DangerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/reporte_titulo_tomo" />

</LinearLayout>
