<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Contenedor de burbuja de mensaje -->
    <LinearLayout
        android:id="@+id/contenedorMensaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Foto de perfil del usuario (mostrar para mensajes del otro usuario) -->
        <ImageView
            android:id="@+id/fotoPerfil"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <!-- Burbuja de mensaje -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:id="@+id/burbujaMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_burbuja_mensaje"
                android:maxWidth="300dp">

                <!-- Nombre del usuario (mostrar para mensajes del otro usuario) -->
                <TextView
                    android:id="@+id/nombreUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp" />

                <!-- Texto del mensaje -->
                <TextView
                    android:id="@+id/textoMensaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:linksClickable="true"
                    android:clickable="true" />

                <!-- Vista previa de imagen -->
                <ImageView
                    android:id="@+id/imagenAdjunta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="300dp"
                    android:maxHeight="360dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@string/app_name" />

                <!-- Vista previa de audio -->
                <LinearLayout
                    android:id="@+id/contenedorAudioAdjunto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textoAudioAdjunto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/audio"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/botonReproducirAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/reproducir" />
                </LinearLayout>

                <!-- Hora y estado -->
                <LinearLayout
                    android:id="@+id/contenedorEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/horaMensaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/gray_light" />

                    <!-- Icono de estado de mensaje (texto para mostrar emojis) -->
                    <TextView
                        android:id="@+id/iconoEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indicador de lectura -->
            <TextView
                android:id="@+id/indicadorLectura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="-4dp"
                android:textSize="10sp"
                android:textColor="@color/blue"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Espacio flexible -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Icono de reacción (emoji) -->
    <ImageButton
        android:id="@+id/botonReaccionar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="@string/reaccionar"
        android:visibility="gone" />
</LinearLayout>
